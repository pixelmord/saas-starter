{
	"extends": "@repo/typescript-config/internal-package.json",
	"compilerOptions": {
		"lib": ["ES2022", "dom", "dom.iterable"],
		"jsx": "preserve",
		"forceConsistentCasingInFileNames": true,
		"baseUrl": ".",
		"paths": {
			"@repo/ui": ["./src"],
			"@repo/ui/*": ["./src/*"],
			"@repo/ui/components/*": ["./src/components/*"],
			"@repo/ui/hooks/*": ["./src/hooks/*"],
			"@repo/ui/lib/*": ["./src/lib/*"],
			"@repo/ui/types/*": ["./src/types/*"]
		}
	},
	"include": ["src"],
	"exclude": ["node_modules"]
}
